# ProofFrame environment configuration
# Copy to .env and adjust. .env is gitignored and never committed.

# --- Backend (Express local analysis API) ---

# Port the video proofing API listens on (default: 8787).
PROOFFRAME_API_PORT=8787

# Comma-separated allowed CORS origins for the API. Leave unset for local
# development (same-origin via the Vite proxy). In a deployed split setup,
# set this to the frontend origin, e.g.
# PROOFFRAME_CORS_ORIGIN=https://proofframe.example.com
# PROOFFRAME_CORS_ORIGIN=

# Optional: override the OpenRouter model used for the AI evidence judge.
# PROOFFRAME_JUDGE_MODEL=google/gemini-2.5-flash

# Optional: override the OpenRouter audio transcription models (comma-separated
# model ids). Defaults to three audio-capable multimodal models.
# PROOFFRAME_STT_MODELS=google/gemini-2.5-flash,google/gemini-2.0-flash-001,openai/gpt-audio

# Note: there is no server OPENROUTER_API_KEY. ProofFrame is BYOK — each user
# pastes their own OpenRouter key in the browser (stored in localStorage) and it
# is forwarded to the backend only for the duration of their scan.

# --- Frontend (Vite, build-time) ---

# Base URL of the backend API. Leave unset for local dev (the Vite dev server
# proxies /api to the backend). For a deployed static frontend whose backend
# runs on a separate origin, set this at build time, e.g.
# VITE_PROOFFRAME_API_BASE=https://proofframe-api.example.com
# VITE_PROOFFRAME_API_BASE=
